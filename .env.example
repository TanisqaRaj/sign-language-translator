# =============================================================================
# .env.example – Sign Language Translator
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is listed in .gitignore and must NEVER be committed to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
# Title shown in the browser tab
APP_TITLE=Sign Language Translator

# Default translation language (must match a key in config.SUPPORTED_LANGUAGES)
DEFAULT_LANGUAGE=English

# Host port that Docker maps to the container's 8501
APP_PORT=8501

# ── Streamlit (override built-in defaults if needed) ─────────────────────────
# These are already set inside the Dockerfile; only set here if you want to
# change them at runtime without rebuilding.
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
# STREAMLIT_SERVER_FILE_WATCHER_TYPE=none
# STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ── GHCR / Docker image (used by docker-compose.yml) ─────────────────────────
# Your GitHub username (lowercase) — used to construct the image name
GITHUB_USERNAME=your-github-username

# Image tag to pull on the deployment server (set by CI, e.g. "latest" or SHA)
IMAGE_TAG=latest

# ── Deployment server (required only for CD workflow) ─────────────────────────
# These values correspond to the GitHub repository secrets of the same name.
# Do NOT put real values here — configure them as GitHub Secrets instead.
# DEPLOY_HOST=your.server.ip.or.hostname
# DEPLOY_USERNAME=your_ssh_user
# DEPLOY_PORT=22

# ── Future extensions (add here if you integrate these services later) ────────
# REDIS_URL=redis://redis:6379/0
# DATABASE_URL=postgresql://user:password@db:5432/signlang
