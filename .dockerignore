# =============================================================================
# .dockerignore – Sign Language Translator
# Excludes everything that should NOT be copied into the Docker image.
#
# ── Model files that ARE included (required by app_cloud.py at runtime) ──────
#   models/gesture_model.tflite       ← word model
#   models/label_map.json             ← word label map
#   models/scaler.pkl                 ← word scaler
#   models/character_model.tflite     ← character model
#   models/character_label_map.json   ← character label map
#   models/character_scaler.pkl       ← character scaler
#   models/movenet_lightning_fp16.tflite ← pose model (used by inference.py)
#
# ── Model files that are excluded (only needed for training, not inference) ──
#   models/*.keras    ← large Keras training checkpoints (~700 KB each)
#   models/*.h5       ← alternative Keras format
# =============================================================================

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pycache
.pytest_cache/

# ── Dataset (large image folders — 500+ MB, not needed for inference) ─────────
dataset/
dataset.txt

# ── CSV landmark files (training data only, NOT needed at runtime) ────────────
# landmarks.csv          — word model training data  (~3 MB)
# character_landmarks.csv — character model training data (~16 MB)
landmarks.csv
character_landmarks.csv
landmarks.npy
sample_check.jpg

# ── Trained Keras / H5 model files (tflite is already converted) ──────────────
# IMPORTANT: only *.keras and *.h5 are excluded.
# All *.tflite, *.pkl, *.json model files ARE included.
models/*.keras
models/*.h5

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Documentation images / reports (not needed at runtime) ───────────────────
docs/*.png
docs/project_report.md
brain.md

# ── Test files ────────────────────────────────────────────────────────────────
tests/

# ── Git ───────────────────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Environment variables (secrets must never go into the image) ──────────────
.env
.env.*
!.env.example

# ── Node (package-lock.json has no runtime purpose here) ─────────────────────
node_modules/
package-lock.json

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── CI / build artifacts ──────────────────────────────────────────────────────
.github/
